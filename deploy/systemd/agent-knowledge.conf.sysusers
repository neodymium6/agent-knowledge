# The deployment-managed SSH account joins both Gateway groups.
g agent-knowledge-gateway - -
g agent-knowledge-ingress - -
g agent-knowledge-access - -
u agent-knowledge - "Agent Knowledge Worker service account" /var/lib/agent-knowledge -
u agent-knowledge-queue - "Agent Knowledge queue ingress account" /var/lib/agent-knowledge -
u agent-knowledge-access - "Agent Knowledge access registry reader" /var/empty -
m agent-knowledge agent-knowledge-queue
