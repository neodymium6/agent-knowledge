[Unit]
Description=Agent Knowledge Queue Ingress Socket
Documentation=https://github.com/neodymium6/agent-knowledge

[Socket]
ListenStream=/run/agent-knowledge/queue-ingress.sock
SocketUser=agent-knowledge-queue
SocketGroup=agent-knowledge-ingress
SocketMode=0660
DirectoryMode=2750
Accept=yes
MaxConnections=64
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
